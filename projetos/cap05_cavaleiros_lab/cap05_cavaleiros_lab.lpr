program cap05_cavaleiros_lab;

{$mode objfpc}{$H+}

uses
  {$IFDEF UNIX}
  cthreads,
  {$ENDIF}
  Interfaces,
  Forms,
  uMainForm,
  uExperiments;

{$R *.res}

begin
